{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "vs2022",
      "inherits": "base",
      "displayName": "VS 2022 (v143, Windows 7 API level)",
      "generator": "Visual Studio 17 2022",
      "toolset": { "value": "v143", "strategy": "set" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-v143"
      }
    },
    {
      "name": "vs2026",
      "inherits": "base",
      "displayName": "VS 2026 (v145, Windows 10 API level)",
      "generator": "Visual Studio 18 2026",
      "toolset": { "value": "v145", "strategy": "set" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-v145"
      }
    }
  ],
  "buildPresets": [
    { "name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "vs2026-debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "vs2026-release", "configurePreset": "vs2026", "configuration": "Release" }
  ]
}
